<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:orientation="vertical"
        android:id="@+id/viewPagerImagenesDialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageButton
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/btnArribaDialog"
        android:background="@android:color/transparent"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/up"
        android:contentDescription="Imagen anterior"/>
    <ImageButton
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/btnAbajoDialog"
        android:background="@android:color/transparent"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/down"
        android:contentDescription="Imagen siguiente"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/txtContadorImagenDialog"
        android:background="#80000000"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:text="Imagen 1 de 1"/>
</FrameLayout>
