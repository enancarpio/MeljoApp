<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="10sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre:"
                android:includeFontPadding="false"
                android:layout_marginEnd="6dp"/>
            <EditText
                android:textSize="10sp"
                android:id="@+id/editNombreUsuario"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="Nombre"
                android:minLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:inputType="textPersonName"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="10sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apellido:"
                android:includeFontPadding="false"
                android:layout_marginEnd="6dp"/>
            <EditText
                android:textSize="10sp"
                android:id="@+id/editApellidoUsuario"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="Apellido"
                android:minLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:inputType="textPersonName"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="10sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email:"
                android:includeFontPadding="false"
                android:layout_marginEnd="6dp"/>
            <EditText
                android:enabled="false"
                android:textSize="10sp"
                android:id="@+id/editEmailUsuario"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="Email"
                android:minLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:inputType="textEmailAddress"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="10sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teléfono:"
                android:includeFontPadding="false"
                android:layout_marginEnd="6dp"/>
            <EditText
                android:textSize="10sp"
                android:id="@+id/etFono"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="Teléfono"
                android:minLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:inputType="number"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="10sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name:"
                android:includeFontPadding="false"
                android:layout_marginEnd="6dp"/>
            <EditText
                android:enabled="false"
                android:textSize="10sp"
                android:id="@+id/editUsernameUsuario"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="Nombre de Usuario"
                android:minLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:inputType="textPersonName"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="10sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contraseña:"
                android:includeFontPadding="false"
                android:layout_marginEnd="6dp"/>
            <EditText
                android:textSize="10sp"
                android:id="@+id/editPasswordUsuario"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="Contraseña"
                android:minLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:inputType="textPassword"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="10sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Admin?:"
                android:includeFontPadding="false"
                android:layout_marginEnd="6dp"/>
            <Spinner
                android:id="@+id/spinnerAdminUsuario"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
