<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Propiedad:"
                android:layout_marginEnd="6dp"/>
            <Spinner
                android:id="@+id/spropiedadesEditar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/mediaContainerEditar"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="10dp">
            <ImageView
                android:id="@+id/imgPreviewEditar"
                android:background="@android:color/darker_gray"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
            <VideoView
                android:id="@+id/videoPreviewEditar"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <Button
            android:id="@+id/bseleccionarEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cambiar Imagen o Video"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Imágen:"
                android:layout_marginEnd="6dp"/>
            <EditText
                android:textSize="12sp"
                android:id="@+id/etNbimagenEditar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="Nombre de imagen o video"
                android:maxLength="20"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
